{
  "name": "@loscolmebrothers/loading",
  "version": "1.1.2",
  "description": "GSAP-powered loading overlay with staggered slice animations — self-contained styles, no Tailwind required",
  "type": "module",
  "access": "public",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "tsup"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "gsap": ">=3.12",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "gsap": "^3.12.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.0"
  }
}